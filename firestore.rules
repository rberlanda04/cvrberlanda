rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Só essa conta pode logar no painel /admin — mesmo que alguém crie
    // outro usuário no Firebase Auth por engano, essa checagem bloqueia.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'r.berlanda04@gmail.com';
    }

    // Mensagens do formulário de contato: qualquer visitante pode criar uma
    // mensagem nova. Só quem está logado (você, pelo painel /admin) consegue
    // ler — ninguém edita ou apaga pelo navegador.
    match /contactMessages/{messageId} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'subject', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() < 300
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 5000;
    }

    // Projetos enviados pela página escondida de cadastro
    // (cadastro-projeto.html): qualquer pessoa com o link pode enviar um
    // projeto novo. Leitura é liberada só pra quem está logado (painel
    // /admin) OU pra projetos já aprovados (é assim que o currículo público
    // mostra os projetos aprovados automaticamente, sem precisar editar o
    // profile.json). Só quem está logado pode mudar o status (aprovar/
    // reprovar), e só esse campo.
    match /projectSubmissions/{submissionId} {
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'logo', 'description', 'ods', 'link', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.logo is string
        && request.resource.data.logo.size() > 0
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() < 2000
        && request.resource.data.ods is list
        && request.resource.data.ods.size() > 0
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
    }

    // Bloqueia qualquer outra coleção por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
